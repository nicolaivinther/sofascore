# Non-secret defaults. Secrets (CONNECTIONSTRING_BB_STATS, SENTRY_DSN) go in the untracked
# .development.env, which overrides this file.
LOGLEVEL=INFO
SENTRY_ENVIRONMENT=development

# Random pause between two Sofascore requests (seconds); one request at a time.
SOFASCORE_PAUSE_MIN_S=3
SOFASCORE_PAUSE_MAX_S=5
# After a 403/429 (Sofascore's rate limit) no run asks Sofascore for this many minutes.
SOFASCORE_COOLDOWN_MIN=60
# The browser that answers a captcha challenge: "chrome" (installed Google Chrome) or "chromium"
# (`poetry run patchright install chromium`). It always opens a visible window, so the machine
# needs a logged-in desktop session.
SOFASCORE_BROWSER_CHANNEL=chrome
